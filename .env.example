# Public demo instance embedded on /demo and the homepage.
# The demo is a static build of the rumahl shell with sample data.
# Defaults to https://demo.rumahl.com when empty.
NEXT_PUBLIC_RUMAHL_DEMO_URL=https://demo.rumahl.com

# Optional: link the developer section to a hosted Storybook build.
# Leave empty to keep the local instructions only.
NEXT_PUBLIC_STORYBOOK_URL=

# Community / blog content is managed in a self-hosted Discourse instance
# (see the separate `discourse` project). The website reads topics server-side
# at request time and renders them in its own design.
#
# If DISCOURSE_URL is empty, the local Markdown articles in content/blog are
# used. If it is set but the community is unreachable, the blog shows a friendly
# "community unavailable" notice (not a 404, and not stale content).
#
# NOTE: the website loads these from a `.env` file in this project. Shell
# environment variables alone are not picked up by the vinext runtime.
DISCOURSE_URL=
# Optional: only needed for a private instance or to raise rate limits.
DISCOURSE_API_KEY=
DISCOURSE_API_USERNAME=website
# Category slugs mapped to website sections.
DISCOURSE_BLOG_CATEGORY=blog
DISCOURSE_RELEASES_CATEGORY=releases
# Cache duration for fetched content, in seconds.
DISCOURSE_REVALIDATE=300

# Shared secret for the Discourse → website webhook that clears the cache when
# new topics or replies are posted. Create the webhook in Discourse pointed at:
#   https://<website>/api/discourse-webhook?token=<this value>
DISCOURSE_WEBHOOK_SECRET=
